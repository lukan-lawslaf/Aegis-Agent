# Client-side SIH configuration. The extension talks only to this FastAPI
# gateway; Ollama/OpenRouter credentials belong on the server machine.
VITE_SIH_FASTAPI_URL=http://127.0.0.1:8000/v1
VITE_SIH_QWEN_MODEL=gemma4:31b-cloud
VITE_SIH_PLANNER_MODEL=qwen3-vl:4b-instruct
VITE_SIH_ENABLE_ANALYTICS=false
# Local ONNX BlazeFace model. Place the file at chrome-extension/public/models/blazeface.onnx
VITE_SIH_BLAZEFACE_MODEL_URL=/models/blazeface.onnx
VITE_SIH_BLAZEFACE_THRESHOLD=0.5
